' KEEP PURE ASCII.
Option Explicit
Dim sh, ok, i, url
Set sh = CreateObject("WScript.Shell")
url = "http://127.0.0.1:8123/"
' ???????dm-3d-viewer-open.vbs "D:\xxx\model.glb"
If WScript.Arguments.Count > 0 Then
    url = url & "?p=" & WScript.Arguments(0)
End If

Function PortAlive(u)
    Dim x
    On Error Resume Next
    Set x = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    x.setTimeouts 1000, 1000, 1000, 1500
    x.open "GET", u, False
    x.send
    PortAlive = (Err.Number = 0) And (x.status > 0)
    On Error GoTo 0
End Function

ok = PortAlive(url)
If Not ok Then
    ' ??????????????????????????????????????????????????????????????????
    sh.Run "schtasks /Run /TN ""DM-3D-Viewer-Server""", 0, True
    For i = 1 To 15
        WScript.Sleep 700
        If PortAlive(url) Then
            ok = True
            Exit For
        End If
    Next
End If

' ???????????????app ?????????????????? Chrome ????????????????????????
Dim chrome
chrome = "C:\Program Files\Google\Chrome\Application\chrome.exe"
Dim fso
Set fso = CreateObject("Scripting.FileSystemObject")
If fso.FileExists(chrome) Then
    sh.Run """" & chrome & """ --app=" & url & " --window-size=1500,950", 1, False
Else
    sh.Run url, 1, False
End If
